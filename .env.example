# Supabase — create a project at https://supabase.com, then copy these from
# Project Settings → API Keys (the new publishable/secret keys, not the legacy
# anon/service_role JWTs). Apply the schema from CLAUDE.md (see README).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=           # server-only — never expose to the client

# External links (no on-site payment processing — redirects only).
# PayPal + Venmo now live in code (content/site.ts `links`); no env var needed.
NEXT_PUBLIC_DONATE_URL=        # optional generic card processor; falls back to PayPal
NEXT_PUBLIC_GLADIATORS_URL=    # https://gladiators.nyc once live

# Contact form email routing (optional — messages are always stored in Supabase;
# set these to also forward each message by email via Resend)
RESEND_API_KEY=
CONTACT_EMAIL_TO=

# Analytics — GTM-first. GA4, Google Ads conversions, and every other tag are
# configured *inside* the GTM container, not here, so marketing can add tracking
# without a deploy. There is deliberately no GA4 Measurement ID in this repo.
# Full setup (both the GTM side and the Wix side): see ANALYTICS.md.
NEXT_PUBLIC_GTM_ID=              # GTM-XXXXXXX. Unset = no tag loads at all.
NEXT_PUBLIC_ANALYTICS_PREVIEW=   # "1" loads the container on a preview deploy so
                                 # GTM Preview mode can connect. NEVER set this in
                                 # production — beta traffic would contaminate the
                                 # pre-cutover baseline the rollout is measured against.
