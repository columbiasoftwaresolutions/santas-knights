# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# asset-library/ is committed (raw source assets, organized by category).
# Selected, web-optimized images live in /public/images.
# Keep source zips out of git — extract into asset-library/ instead.
*.zip

# Raw video and duplicate-review media are local source archives. They are not
# used by the app and include files too large for a normal GitHub push.
/asset-library/video/
/asset-library/_review/
/design-demos/verified-*.png

# e2e test artifacts (the e2e/ scripts are committed; their outputs aren't)
/e2e-screenshots/
/e2e-assets/
