{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "santas-knights-migration-test",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "html_handling": "none",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*",
      "!/_next/static/*",
      "!/*/_next/static/*"
    ]
  },
  "images": {
    "binding": "IMAGES"
  },
  "account_id": "ba13014db202d039308b92baaaeccc2c",
  "keep_vars": true,
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "triggers": {
    "crons": []
  }
}
